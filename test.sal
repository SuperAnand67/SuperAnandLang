$ Welcome to SuperAnandLang $

whatis "HelloWorld!";

$ this is a single line comment $
whatis 293;

whatis 220 - 10 + 100;

whatis (20 + 10) * 2;

whatis "12*34"; $ this prints the string inside "", not do the math in the inside expression $

believe x = 10;
whatis x;

x = x + 10;
whatis x; $ output should be -> x = 20; $

believe y = (x * (x - 10)) + (x + x);
whatis y;   $ output : 240 $

believe z;
z = x + y * 2;
whatis z; $ output : 500 $

z++;
whatis z;

z--;
whatis z;

z = 50;
whatis z;

