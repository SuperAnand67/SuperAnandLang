
{
  "scopeName": "source.superanandlang-code",
  "patterns": [
    {
      "name": "comment.block.superanandlang-code",
      "begin": "\\$",
      "end": "\\$"
    },
    {
      "name": "string.quoted.double.superanandlang-code",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.superanandlang-code",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.superanandlang-code",
      "match": "\\b(whatis|believe)\\b"
    },
    {
      "name": "constant.numeric.integer.superanandlang-code",
      "match": "\\b[0-9]+\\b"
    },
    {
      "name": "keyword.operator.increment.superanandlang-code",
      "match": "\\+\\+"
    },
    {
      "name": "keyword.operator.decrement.superanandlang-code",
      "match": "--"
    },
    {
      "name": "keyword.operator.arithmetic.superanandlang-code",
      "match": "[+*/-]"
    },
    {
      "name": "keyword.operator.assignment.superanandlang-code",
      "match": "="
    },
    {
      "name": "punctuation.separator.superanandlang-code",
      "match": ";"
    },
    {
      "name": "punctuation.section.parens.superanandlang-code",
      "match": "[()]"
    },
    {
      "name": "variable.other.superanandlang-code",
      "match": "\\b[a-zA-Z][a-zA-Z0-9_]*\\b"
    }
  ]
}
